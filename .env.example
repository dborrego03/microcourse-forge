# Copy to .env and fill in what you use. Never commit .env.

DATABASE_URL=postgresql://forge:forge_dev_password@localhost:5432/microcourse

# Narration (OpenAI text-to-speech). Without a key the "Add narration" button explains it's off.
OPENAI_API_KEY=
# Price per minute of audio from OpenAI's pricing page, used to fill audio_assets.cost_usd.
FORGE_TTS_USD_PER_MINUTE=

# Tracing (optional). Local Jaeger: docker compose --profile tracing up -d
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Langfuse Cloud (EU) instead:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of public_key:secret_key>
